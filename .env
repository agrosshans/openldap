OPENLDAP_BOOTSTRAP_ORGANIZATION=Lanathome Org
OPENLDAP_BOOTSTRAP_SUFFIX=dc=lanathome,dc=org
OPENLDAP_BOOTSTRAP_DATA_ROOT_DN=cn=admin,ou=services,dc=lanathome,dc=org
