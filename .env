OPENLDAP_BOOTSTRAP_TLS_CA_CERT=/usr/local/share/ca-certificates/lanathome.org-root.crt
OPENLDAP_BOOTSTRAP_DATA_TREE=true
OPENLDAP_BOOTSTRAP_DATA_ADMIN=true
OPENLDAP_BOOTSTRAP_DATA_ADMIN_PASSWORD_HASHED='{ARGON2}$argon2id$v=19$m=7168,t=5,p=1$1KSuOZDWyg4HtKCZOx/70Q$xhB7FR9rs6i7UlySHctek+euz/d2ZKS81ZTDkkRkTEo'
OPENLDAP_BOOTSTRAP_DATA_READONLY_DN=cn=readonly,dc=lanathome,dc=org
OPENLDAP_BOOTSTRAP_DATA_READONLY_PASSWORD_HASHED='{ARGON2}$argon2id$v=19$m=7168,t=5,p=1$1KSuOZDWyg4HtKCZOx/70Q$xhB7FR9rs6i7UlySHctek+euz/d2ZKS81ZTDkkRkTEo'
OPENLDAP_BOOTSTRAP_TLS_VERIFY_CLIENT=never